{
  "name": "studypilot-desk",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "半年算法转向学习操作系统",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "dev:tauri": "tauri dev",
    "dev:renderer": "vite --host 127.0.0.1",
    "build:frontend": "vite build",
    "build": "npm run build:tauri",
    "build:tauri": "npm run build:backend-runtime && tauri build",
    "build:backend-runtime": "node scripts/build-backend-runtime.mjs",
    "dist:win": "npm run build:tauri",
    "check:versions": "node scripts/check-version-sync.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build:frontend && playwright test",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4173",
    "start:tauri": "tauri dev",
    "tauri:android:init": "tauri android init",
    "tauri:ios:init": "tauri ios init"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "docx-preview": "^0.4.0",
    "katex": "^0.18.1",
    "mermaid": "^11.16.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
